# Copiare in .env per Compose. Scegliere una password locale; mai riutilizzarla online.
# Sprint 5 riutilizza questi segreti: non sovrascrivere una .env esistente.
POSTGRES_USER=radura
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=radura
WEB_PORT=3000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
# Avvio Go fuori da Docker: esportare queste variabili nella shell (Go non legge .env).
DATABASE_URL=postgres://radura:replace-with-a-local-password@localhost:5432/radura?sslmode=disable
API_ADDR=127.0.0.1:8080
SESSION_TTL_HOURS=168
# Next locale: il default è http://127.0.0.1:8080, configurabile al build.
API_INTERNAL_URL=http://127.0.0.1:8080
NEXT_PUBLIC_PRODUCT_NAME=Radura
# SMTP locale: Mailpit cattura le email, non le inoltra su Internet.
SMTP_ADDR=127.0.0.1:1025
SMTP_FROM=Radura <no-reply@radura.test>
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
NEXT_PUBLIC_DEV_MAILBOX_URL=http://localhost:8025
# Storage S3 locale (SeaweedFS). Generare un segreto casuale di almeno 32 byte.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=radura-media
S3_ACCESS_KEY=radura-local
S3_SECRET_KEY=replace-with-a-random-local-secret-of-at-least-32-bytes
BETA_INVITE_ONLY=true
# Generare un token casuale; scripts/prepare-sprint6.ps1 aggiunge solo questo se assente.
# METRICS_TOKEN is generated by scripts/prepare-sprint6.ps1; never use a shared example token.
# Solo override HTTPS locale con Mailpit; mai abilitare con SMTP pubblico.
SMTP_ALLOW_LOCAL_PLAINTEXT=false
