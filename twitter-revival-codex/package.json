{
  "name": "radura-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typecheck -w apps/web",
    "format": "prettier --write \"{apps,docs,infra,scripts,.github}/**/*.{ts,tsx,css,json,md,mjs,yaml,yml}\" \"*.{json,ts,mjs,md,yaml,yml}\"",
    "format:check": "prettier --check \"{apps,docs,infra,scripts,.github}/**/*.{ts,tsx,css,json,md,mjs,yaml,yml}\" \"*.{json,ts,mjs,md,yaml,yml}\"",
    "test:smoke": "playwright test",
    "test:e2e": "playwright test --grep @auth",
    "test:https": "playwright test -c playwright.https.config.ts",
    "test:load": "node scripts/load-test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prettier": "^3.8.1"
  }
}
