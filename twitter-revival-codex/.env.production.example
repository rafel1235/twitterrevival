# Esempio intenzionalmente non avviabile. Non usare i segreti locali online.
# Generare .env.production con: node scripts/production-config.mjs init DOMINIO EMAIL_ACME
DOMAIN=beta.example.invalid
ACME_EMAIL=operatore@example.invalid
RELEASE_TAG=beta-001
PUBLIC_BETA_ENABLED=false
POSTGRES_PASSWORD=SET_ME
S3_ACCESS_KEY=SET_ME
S3_SECRET_KEY=SET_ME
METRICS_TOKEN=SET_ME
# Relay SMTP con STARTTLS obbligatorio; niente Mailpit sul server.
SMTP_ADDR=smtp.example.invalid:587
SMTP_FROM=Radura <no-reply@beta.example.invalid>
SMTP_USERNAME=SET_ME
SMTP_PASSWORD=SET_ME
